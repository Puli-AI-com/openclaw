# Lightweight patch image: starts from the already-built puli-envoy:latest and
# only adds uv + the updated entrypoint.sh. Avoids the full TypeScript recompile.
FROM 470725743950.dkr.ecr.eu-west-1.amazonaws.com/puli-envoy:latest-amd64-base

USER root

# Install uv to /usr/local/bin so it is in PATH for all exec'd shell commands.
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
 && [ -e /usr/local/bin/uvx ] || ln -sf /usr/local/bin/uv /usr/local/bin/uvx

COPY --chown=node:node entrypoint.sh /app/entrypoint.sh
COPY --chown=node:node scripts/reconcile-openclaw-config.mjs /app/scripts/reconcile-openclaw-config.mjs
RUN chmod +x /app/entrypoint.sh

USER node
